---
import "../styles/site.css";
import { Content as Intro } from "../content/report-intro.md";
import { Content as DualApproach } from "../content/dual-approach.md";
import { Content as RlApproach } from "../content/rl-approach.md";
import { Content as RlLearning } from "../content/rl-learning.md";
import { Content as RlSim2Real } from "../content/rl-sim2real.md";
import { Content as ClassicalApproach } from "../content/classical-approach.md";
import { Content as DeploymentResults } from "../content/deployment-results.md";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fdfdfd" />
    <title>Low Crane Tech Report</title>
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      document.documentElement.dataset.theme =
        savedTheme ??
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="#top">Low Crane Tech Report</a>
      <nav aria-label="Main navigation">
        <a href="/team/">The Team</a>
      </nav>
      <button
        class="theme-toggle"
        type="button"
        aria-label="Toggle color theme"
        title="Toggle color theme"
      >
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"></path></svg
        >
      </button>
    </header>

    <main id="top">
      <section class="hero" aria-label="Low Crane Tech Report">
        <Intro />
        <div class="hero-image media-frame light-frame">
          <img
            src="/media/course-map.png"
            alt=""
            width="1604"
            height="1604"
            fetchpriority="high"
          />
        </div>
      </section>
      <section class="report-section" id="dual-approach">
        <div class="dual-layout">
          <div class="dual-copy"><DualApproach /></div>
          <div class="media-frame dual-photo">
            <img
              src="/media/drone.jpg"
              alt="Low Crane drone"
              width="4284"
              height="5712"
              loading="lazy"
            />
          </div>
        </div>
      </section>
      <section class="report-section" id="rl-approach">
        <RlApproach />
        <figure class="figure">
          <div class="media-frame dark-frame">
            <img
              src="/media/rl-policy.png"
              alt="Actor and critic network architecture"
              width="2263"
              height="1143"
              loading="lazy"
            />
          </div>
        </figure>
        <RlLearning />
        <figure class="figure">
          <div class="media-frame dark-frame">
            <img
              src="/media/rl-sampling.png"
              alt="Success Guided Sampling: the most-sampled start states move from the landing pad back to the launch over training"
              width="2660"
              height="1260"
              loading="lazy"
            />
          </div>
        </figure>
        <RlSim2Real />
        <div class="two-up videos">
          <figure class="player">
            <video
              muted
              loop
              controls
              playsinline
              preload="metadata"
              aria-label="RL Approach video one"
              ><source src="/media/clip-1.mp4" type="video/mp4" /></video
            >
          </figure>
          <figure class="player">
            <video
              muted
              loop
              controls
              playsinline
              preload="metadata"
              aria-label="RL Approach video two"
              ><source src="/media/clip-2.mp4" type="video/mp4" /></video
            >
          </figure>
        </div>
      </section>
      <section class="report-section" id="classical-approach">
        <ClassicalApproach />
        <div class="two-up">
          <div class="media-frame">
            <img
              src="/media/classical-localization.png"
              alt=""
              width="1920"
              height="1080"
              loading="lazy"
            />
          </div>
          <div class="media-frame">
            <img
              src="/media/classical-planning.png"
              alt=""
              width="1920"
              height="1080"
              loading="lazy"
            />
          </div>
        </div>
        <div class="two-up videos">
          <figure class="player">
            <video
              muted
              loop
              controls
              playsinline
              preload="metadata"
              poster="/media/classical-localization.png"
              aria-label="Classical Approach localization video"
              ><source src="/media/clip-3.mp4" type="video/mp4" /></video
            >
          </figure>
          <figure class="player">
            <video
              muted
              loop
              controls
              playsinline
              preload="metadata"
              poster="/media/classical-planning.png"
              aria-label="Classical Approach planning video"
              ><source src="/media/clip-4.mp4" type="video/mp4" /></video
            >
          </figure>
        </div>
      </section>
      <section class="report-section" id="deployment-results">
        <div class="deployment-copy">
          <img
            class="deployment-gif"
            src="/media/shake-fist.gif"
            alt="Homer Simpson shaking his fist"
            width="220"
            height="166"
            loading="lazy"
          />
          <DeploymentResults />
        </div>
        <figure class="player result-video">
          <video
            muted
            loop
            controls
            playsinline
            preload="metadata"
            poster="/media/flight-course.png"
            aria-label="Deployment and Results video"
            ><source src="/media/clip-5.mp4" type="video/mp4" /></video
          >
        </figure>
      </section>
    </main>
    <script>
      import "../scripts/player";
      document
        .querySelector<HTMLButtonElement>(".theme-toggle")
        ?.addEventListener("click", () => {
          const next =
            document.documentElement.dataset.theme === "dark"
              ? "light"
              : "dark";
          document.documentElement.dataset.theme = next;
          localStorage.setItem("theme", next);
        });
    </script>
  </body>
</html>
