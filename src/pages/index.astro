---
import "../styles/site.css";
import dualApproach from "../content/dual-approach.txt?raw";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fdfdfd" />
    <title>Low Crane Tech Report</title>
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      document.documentElement.dataset.theme =
        savedTheme ??
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="#top">Low Crane Tech Report</a>
      <nav aria-label="Main navigation">
        <a href="/team/">The Team</a>
      </nav>
      <button
        class="theme-toggle"
        type="button"
        aria-label="Toggle color theme"
        title="Toggle color theme"
      >
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"></path></svg
        >
      </button>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="report-title">
        <h1 id="report-title">Low Crane Tech Report</h1>
        <div class="hero-image media-frame light-frame">
          <img
            src="/media/course-map.png"
            alt=""
            width="1604"
            height="1604"
            fetchpriority="high"
          />
        </div>
      </section>

      <section
        class="report-section"
        id="dual-approach"
        aria-labelledby="dual-title"
      >
        <h2 id="dual-title">Our Dual Approach</h2>
        <div class="approach-copy">{dualApproach}</div>
      </section>

      <section
        class="report-section"
        id="rl-approach"
        aria-labelledby="rl-title"
      >
        <h2 id="rl-title">RL Approach</h2>
        <div class="media-frame dark-frame">
          <img
            src="/media/rl-sampling.png"
            alt=""
            width="2660"
            height="1260"
            loading="lazy"
          />
        </div>
        <div class="two-up videos">
          <video
            controls
            playsinline
            preload="metadata"
            aria-label="RL Approach video one"
            ><source src="/media/clip-1.mp4" type="video/mp4" /></video
          >
          <video
            controls
            playsinline
            preload="metadata"
            aria-label="RL Approach video two"
            ><source src="/media/clip-2.mp4" type="video/mp4" /></video
          >
        </div>
      </section>

      <section
        class="report-section"
        id="classical-approach"
        aria-labelledby="classical-title"
      >
        <h2 id="classical-title">Classical Approach</h2>
        <div class="two-up">
          <div class="media-frame">
            <img
              src="/media/classical-localization.png"
              alt=""
              width="1920"
              height="1080"
              loading="lazy"
            />
          </div>
          <div class="media-frame">
            <img
              src="/media/classical-planning.png"
              alt=""
              width="1920"
              height="1080"
              loading="lazy"
            />
          </div>
        </div>
        <div class="two-up videos">
          <video
            controls
            playsinline
            preload="metadata"
            poster="/media/classical-localization.png"
            aria-label="Classical Approach localization video"
            ><source src="/media/clip-3.mp4" type="video/mp4" /></video
          >
          <video
            controls
            playsinline
            preload="metadata"
            poster="/media/classical-planning.png"
            aria-label="Classical Approach planning video"
            ><source src="/media/clip-4.mp4" type="video/mp4" /></video
          >
        </div>
      </section>

      <section
        class="report-section"
        id="deployment-results"
        aria-labelledby="results-title"
      >
        <h2 id="results-title">Deployment and Results</h2>
        <div class="media-frame">
          <img
            src="/media/flight-course.png"
            alt=""
            width="1920"
            height="1080"
            loading="lazy"
          />
        </div>
        <video
          class="result-video"
          controls
          playsinline
          preload="metadata"
          poster="/media/flight-course.png"
          aria-label="Deployment and Results video"
          ><source src="/media/clip-5.mp4" type="video/mp4" /></video
        >
      </section>
    </main>
    <script>
      document
        .querySelector<HTMLButtonElement>(".theme-toggle")
        ?.addEventListener("click", () => {
          const next =
            document.documentElement.dataset.theme === "dark"
              ? "light"
              : "dark";
          document.documentElement.dataset.theme = next;
          localStorage.setItem("theme", next);
        });
    </script>
  </body>
</html>
